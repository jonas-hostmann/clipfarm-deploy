# ClipFarm – Environment Variables Template
# Kopiere diese Datei nach .env und fülle deine Werte ein

# ─────────────────────────────────────────────
# POSTGRES (Datenbank)
# ─────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-to-a-secure-password-32-chars-long

# ─────────────────────────────────────────────
# SUPOCLIP (KI Clip-Engine)
# ─────────────────────────────────────────────
# Wird über Dashboard konfiguriert (OpenRouter empfohlen)
# Diese Werte werden automatisch vom Dashboard gesetzt
LLM=openai:claude-3.5-sonnet
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=

# Transcription (optional – lassen wenn Whisper lokal genutzt wird)
ASSEMBLY_AI_API_KEY=

# ─────────────────────────────────────────────
# MINIO (S3 Storage)
# ─────────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-to-a-secure-password

# ─────────────────────────────────────────────
# N8N (Automation)
# ─────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change-me-to-a-secure-password
N8N_HOST=n8n.clipfarm.hostmann-media.de

# ─────────────────────────────────────────────
# COOLIFY (für Dashboard-Integration)
# ─────────────────────────────────────────────
COOLIFY_URL=https://coolify.hostmann-media.de
COOLIFY_TOKEN=
SUPOCLIP_APP_UUID=

# ─────────────────────────────────────────────
# OPTIONAL: Backblaze B2 (externer Backup-Storage)
# ─────────────────────────────────────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=clipfarm-backup

# ─────────────────────────────────────────────
# OPTIONAL: YouTube API (für Monitoring)
# ─────────────────────────────────────────────
YOUTUBE_API_KEY=

# ─────────────────────────────────────────────
# OPTIONAL: Telegram Alerts
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
